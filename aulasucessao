<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sucessão sem complicação | RegenerAÇÃO Óptica</title>
<meta name="description" content="Uma conversa prática para quem quer preparar a próxima geração e fortalecer o futuro da sua ótica. Aula ao vivo, online e gratuita, 08/09/2026.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,600&display=swap" rel="stylesheet">
<style>
  :where(.sib-form-message-panel) { display:none; }
</style>

<style>
  :root{
    --blue:#174496;
    --blue-deep:#0F2D66;
    --blue-pale:#EDF1FA;
    --orange:#EF7A14;
    --orange-soft:#F79C4C;
    --orange-pale:#FDEEE0;
    --ink:#122148;
    --ink-soft:#5B6786;
    --paper:#FFFFFF;
    --paper-soft:#F5F6FA;
    --line:rgba(23,68,150,0.14);
    --radius-lg:28px;
    --radius-md:18px;
    --maxw:1180px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Poppins',sans-serif;
    font-size:16px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;}

  h1,h2,h3{
    font-family:'Poppins',sans-serif;
    font-weight:700;
    line-height:1.14;
    margin:0;
    letter-spacing:-0.01em;
    color:var(--blue-deep);
  }

  .wrap{
    max-width:var(--maxw);
    margin:0 auto;
    padding:0 32px;
  }

  .eyebrow{
    text-transform:uppercase;
    letter-spacing:0.12em;
    font-size:12.5px;
    font-weight:700;
    display:inline-flex;
    align-items:center;
    gap:10px;
    color:var(--orange);
  }

  .badge-pill{
    display:inline-flex;
    align-items:center;
    gap:10px;
    background:var(--orange-pale);
    color:var(--orange);
    border:1px solid rgba(239,122,20,0.28);
    padding:9px 18px;
    border-radius:100px;
    font-size:13px;
    font-weight:600;
    letter-spacing:0.02em;
  }
  .badge-pill .sep{ opacity:0.5; }

  /* ===== Header ===== */
  header{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(255,255,255,0.9);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .header-inner{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    padding:8px 32px;
    max-width:var(--maxw);
    margin:0 auto;
  }
  .brand{
    display:flex;
    align-items:center;
    justify-content:center;
    grid-column:2;
  }
  .brand img{height:104px;width:auto;}
  .header-cta{
    grid-column:3;
    justify-self:end;
    font-size:13.5px;
    font-weight:600;
    letter-spacing:0.01em;
    background:var(--blue);
    color:#fff;
    padding:12px 22px;
    border-radius:100px;
    text-decoration:none;
    white-space:nowrap;
    transition:transform .25s ease, background .25s ease;
  }
  .header-cta:hover{ background:var(--orange); transform:translateY(-1px); }

  /* ===== Hero ===== */
  .hero{
    position:relative;
    overflow:hidden;
    padding:76px 0 0;
    background:
      radial-gradient(circle at 88% -10%, var(--blue-pale) 0%, transparent 55%),
      radial-gradient(circle at 6% 108%, var(--orange-pale) 0%, transparent 45%);
  }
  .hero-inner{
    max-width:820px;
    margin:0 auto;
    text-align:center;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .hero-eyebrow{ margin-bottom:24px; }
  h1.hero-title{
    font-size:clamp(38px, 6vw, 70px);
    color:var(--blue-deep);
  }
  h1.hero-title .accent{
    color:var(--orange);
    font-style:italic;
    font-weight:700;
  }
  .hero-lede{
    margin-top:24px;
    font-size:clamp(16.5px,1.9vw,19.5px);
    color:var(--ink-soft);
    max-width:56ch;
  }
  .hero-lede strong{ color:var(--ink); font-weight:600; }

  .chip-row{
    margin-top:36px;
    display:flex;
    flex-wrap:nowrap;
    justify-content:center;
    gap:16px;
    max-width:100%;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:none;
    padding:4px 4px 10px;
  }
  .chip-row::-webkit-scrollbar{ display:none; }
  .chip{
    display:flex;
    align-items:center;
    gap:12px;
    background:#fff;
    border:1px solid var(--line);
    padding:18px 28px;
    border-radius:100px;
    font-size:19px;
    font-weight:700;
    color:var(--ink);
    box-shadow:0 8px 20px -14px rgba(23,68,150,0.4);
    flex:none;
    white-space:nowrap;
  }
  .chip .ico{
    width:23px;height:23px;
    flex:none;
    color:var(--blue);
  }

  .hero-actions{
    margin-top:38px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:16px;
  }
  .btn-primary{
    font-weight:700;
    font-size:15.5px;
    letter-spacing:0.01em;
    background:var(--orange);
    color:#fff;
    border:none;
    padding:19px 34px;
    border-radius:100px;
    cursor:pointer;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:10px;
    box-shadow:0 14px 30px -12px rgba(239,122,20,0.55);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 18px 36px -10px rgba(239,122,20,0.6); }
  .hero-note{
    font-size:13.5px;
    font-weight:500;
    color:var(--ink-soft);
  }
  .hero-note a{
    color:var(--blue);
    font-weight:600;
    text-decoration:none;
    border-bottom:1.5px solid var(--blue-pale);
  }
  .hero-note a:hover{ border-color:var(--blue); }

  /* Ticker strip */
  .ticker{
    margin-top:56px;
    background:var(--blue-deep);
    overflow:hidden;
    padding:15px 0;
  }
  .ticker-track{
    display:flex;
    gap:14px;
    white-space:nowrap;
    animation:ticker-scroll 26s linear infinite;
    width:max-content;
  }
  .ticker-track span{
    color:#fff;
    font-size:13.5px;
    font-weight:600;
    letter-spacing:0.02em;
    opacity:0.9;
  }
  .ticker-track span.star{ color:var(--orange-soft); }
  @keyframes ticker-scroll{
    from{ transform:translateX(0); }
    to{ transform:translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce){
    .ticker-track{ animation:none; }
  }

  /* ===== Section shells ===== */
  section{ padding:92px 0; }
  .section-tight{ padding:60px 0; }
  .bg-soft{ background:var(--paper-soft); }
  .divider{
    width:100%;
    height:1px;
    background:var(--line);
  }

  /* ===== Question / Intro ===== */
  .intro-quote{
    font-style:italic;
    font-weight:600;
    font-size:clamp(24px,3.2vw,36px);
    color:var(--blue-deep);
    max-width:19ch;
    line-height:1.3;
  }
  .intro-grid{
    display:grid;
    grid-template-columns:0.9fr 1.1fr;
    gap:64px;
    align-items:start;
  }
  .intro-body p{
    font-size:17px;
    color:var(--ink-soft);
    margin:0 0 20px;
  }
  .intro-body p:last-child{ margin-bottom:0; }
  .intro-body strong{ color:var(--ink); font-weight:600; }

  /* ===== Learn section ===== */
  .learn-head{
    max-width:60ch;
    margin-bottom:52px;
  }
  .learn-head h2{
    font-size:clamp(28px,3.8vw,42px);
    margin-top:14px;
  }
  .learn-head h2 .accent{ color:var(--orange); font-style:italic; }
  .learn-head .learn-lede{
    margin-top:16px;
    font-size:17px;
    color:var(--ink-soft);
    max-width:62ch;
  }
  .learn-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:24px;
  }
  .learn-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:22px;
    padding:30px 28px;
    display:flex;
    gap:20px;
  }
  .learn-num{
    flex:none;
    width:46px;
    height:46px;
    border-radius:50%;
    background:var(--blue-pale);
    color:var(--blue);
    font-weight:700;
    font-size:15px;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .learn-card h3{
    font-size:18.5px;
    color:var(--blue-deep);
  }
  .learn-card p{
    margin-top:8px;
    font-size:14.5px;
    color:var(--ink-soft);
  }

  /* ===== Speakers ===== */
  .speakers-head{
    max-width:66ch;
    margin-bottom:52px;
  }
  .speakers-head p.lead{
    margin-top:14px;
    font-size:clamp(19px,2.4vw,25px);
    font-weight:500;
    color:var(--ink);
    line-height:1.45;
  }
  .speaker-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:36px;
  }
  .speaker-card{
    background:#fff;
    border-radius:var(--radius-lg);
    padding:36px;
    border:1px solid var(--line);
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
  }
  .speaker-photo{
    width:220px;
    height:220px;
    border-radius:50%;
    overflow:hidden;
    flex:none;
    border:6px solid var(--orange-pale);
    margin-bottom:24px;
  }
  .speaker-photo img{
    width:100%;height:100%;object-fit:cover;
  }
  .speaker-card h3{
    font-size:24px;
    color:var(--blue-deep);
  }
  .speaker-role{
    font-size:13px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--orange);
    font-weight:700;
    margin-top:8px;
    display:block;
  }
  @media (max-width:700px){
    .speaker-photo{ width:180px; height:180px; }
  }

  /* ===== Form ===== */
  .form-shell{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:0;
    background:#fff;
    border-radius:var(--radius-lg);
    overflow:hidden;
    border:1px solid var(--line);
  }
  .form-side{
    background:var(--blue);
    color:#fff;
    padding:56px 46px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    position:relative;
    overflow:hidden;
  }
  .form-side::after{
    content:'';
    position:absolute;
    width:340px;height:340px;
    border-radius:50%;
    background:rgba(255,255,255,0.06);
    right:-140px; bottom:-140px;
  }
  .form-side .eyebrow{ color:var(--orange-soft); }
  .form-side h2{
    font-size:clamp(26px,3vw,32px);
    color:#fff;
    margin-top:18px;
  }
  .form-side p{
    margin-top:16px;
    font-size:15.5px;
    color:rgba(255,255,255,0.82);
    max-width:34ch;
  }
  .form-side .side-list{
    list-style:none;
    padding:0;
    margin:32px 0 0;
    display:flex;
    flex-direction:column;
    gap:14px;
    position:relative;
  }
  .form-side .side-list li{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:14.5px;
    font-weight:500;
  }
  .side-list .mark{
    width:20px;height:20px;
    flex:none;
    border-radius:50%;
    border:1.5px solid var(--orange-soft);
    position:relative;
  }
  .side-list .mark::after{
    content:'';
    position:absolute;
    inset:5px;
    border-radius:50%;
    background:var(--orange-soft);
  }

  .form-main{ padding:56px 46px; }

  /* ===== Brevo embedded form — reskinned to match our design ===== */
  .brevo-embed, .brevo-embed *{ box-sizing:border-box; }
  .brevo-embed{ text-align:left; background:transparent; }
  .brevo-embed .sib-form-container{ text-align:left; position:static; }
  .brevo-embed #sib-container{
    max-width:none;
    text-align:left;
    background:transparent;
    border:none;
    border-radius:0;
    direction:ltr;
    position:static;
    display:block;
    float:none;
  }
  .brevo-embed form{ display:block; position:static; }
  .brevo-embed .sib-input{
    display:block;
    position:static;
    float:none;
    margin:0 0 20px;
    padding:0;
    width:100%;
  }
  .brevo-embed .sib-sms-field{
    display:block;
    position:static;
    float:none;
    margin:0 0 20px;
    padding:0;
    width:100%;
  }
  .brevo-embed .form__entry{ display:block; position:static; }
  .brevo-embed .form__label-row{ display:block; position:static; }
  .brevo-embed .entry__label{
    display:block;
    position:static;
    font-family:'Poppins',sans-serif;
    font-size:12.5px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    font-weight:600;
    color:var(--ink-soft);
    margin:0 0 8px;
  }
  .brevo-embed .entry__field{ display:block; position:static; width:100%; margin:0; }
  .brevo-embed input.input{
    display:block;
    width:100%;
    padding:14px 16px;
    margin:0;
    border-radius:12px;
    border:1.5px solid var(--line);
    background:var(--paper-soft);
    font-family:'Poppins',sans-serif;
    font-size:15px;
    color:var(--ink);
    transition:border-color .2s ease, background .2s ease;
    box-sizing:border-box;
  }
  .brevo-embed input.input:focus{
    outline:none;
    border-color:var(--blue);
    background:#fff;
  }
  .brevo-embed input.input--hidden{ display:none; }

  /* Phone / SMS field */
  .brevo-embed .sib-sms-input-wrapper{
    display:flex;
    align-items:stretch;
    position:static;
    width:100%;
  }
  .brevo-embed .sib-sms-input{
    display:flex;
    align-items:stretch;
    position:static;
    gap:8px;
    width:100%;
    min-width:0;
  }
  .brevo-embed .sib-sms-input .entry__field:first-child{
    width:104px;
    flex:none;
  }
  .brevo-embed .sib-sms-input .entry__field{
    flex:1 1 auto;
    width:auto;
    min-width:0;
  }
  .brevo-embed .sib-sms-input .entry__field input.input{
    width:100%;
  }
  .brevo-embed select.input{
    display:block;
    width:100%;
    height:100%;
    padding:14px 6px;
    margin:0;
    border-radius:12px;
    border:1.5px solid var(--line);
    background:var(--paper-soft);
    font-family:'Poppins',sans-serif;
    font-size:13px;
    color:var(--ink);
    box-sizing:border-box;
  }
  .brevo-embed .sib-sms-tooltip{ display:none; }

  @media (max-width:480px){
    .brevo-embed .sib-sms-input .entry__field:first-child{ width:84px; }
    .brevo-embed select.input{ font-size:12px; padding:14px 4px; }
  }

  .brevo-embed .entry__error{
    display:block;
    position:static;
    float:none;
    margin:6px 0 0;
    padding:0 !important;
    font-size:12.5px;
    font-weight:500;
    color:#B42323;
    background:transparent !important;
    border:none !important;
  }
  .brevo-embed .entry__error:empty{ display:none; margin:0; }

  /* Submit button */
  .brevo-embed .sib-form-block{ display:block; position:static; float:none; width:100%; margin:0; padding:0; }
  .brevo-embed .sib-form-block:has(button){ text-align:left; padding-top:8px; }
  .brevo-embed .sib-form-block__button{
    display:block;
    position:static;
    width:100%;
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:15px;
    letter-spacing:0.01em;
    background:var(--orange) !important;
    color:#fff !important;
    border:none !important;
    padding:17px 20px;
    margin:0;
    border-radius:12px;
    cursor:pointer;
    transition:background .2s ease, transform .2s ease;
    text-align:center !important;
  }
  .brevo-embed .sib-form-block__button:hover{ background:#d4690f !important; transform:translateY(-1px); }
  .brevo-embed .sib-form-block__button svg{ display:none; }

  /* Success / error message panels */
  .brevo-embed .sib-form-message-panel{
    position:static;
    margin:0 0 20px;
    border-radius:14px !important;
    padding:20px !important;
    font-family:'Poppins',sans-serif !important;
  }
  .brevo-embed .sib-form-message-panel__text{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .brevo-embed #success-message{
    background:var(--orange-pale) !important;
    border:1px solid rgba(239,122,20,0.28) !important;
  }
  .brevo-embed #success-message .sib-icon{ color:var(--orange); }
  .brevo-embed #success-message .sib-form-message-panel__inner-text{
    color:var(--blue-deep) !important;
    font-size:14.5px !important;
    font-weight:500;
  }
  .brevo-embed #error-message{
    background:#FDECEC !important;
    border:1px solid rgba(200,40,40,0.25) !important;
  }
  .brevo-embed #error-message .sib-icon{ color:#B42323; }
  .brevo-embed #error-message .sib-form-message-panel__inner-text{
    color:#B42323 !important;
    font-size:14.5px !important;
    font-weight:500;
  }
  .brevo-embed .sib-icon{ width:22px; height:22px; flex:none; fill:currentColor; }

  .form-fineprint{
    margin-top:14px;
    font-size:12.5px;
    color:var(--ink-soft);
    text-align:center;
  }

  /* ===== WhatsApp band ===== */
  .whats-band{
    background:var(--orange);
    border-radius:var(--radius-lg);
    padding:44px 48px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
    flex-wrap:wrap;
    color:#fff;
  }
  .whats-band h3{
    font-size:clamp(15.5px,1.6vw,17.5px);
    font-weight:500;
    color:rgba(255,255,255,0.92);
    max-width:38ch;
  }
  .whats-btn{
    flex:none;
    background:#fff;
    color:var(--orange);
    font-weight:700;
    font-size:16px;
    letter-spacing:0.01em;
    padding:20px 34px;
    border-radius:100px;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:12px;
    box-shadow:0 14px 30px -14px rgba(15,45,102,0.4);
    transition:transform .2s ease;
  }
  .whats-btn:hover{ transform:translateY(-2px); }

  /* ===== Martinato ===== */
  .martinato-grid{
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:64px;
    align-items:start;
  }
  .martinato p{
    margin-top:20px;
    font-size:16.5px;
    color:var(--ink-soft);
    max-width:56ch;
  }
  .martinato-stat{
    margin-top:32px;
    display:inline-flex;
    align-items:center;
    gap:16px;
    background:var(--blue-pale);
    padding:16px 26px;
    border-radius:18px;
  }
  .martinato-stat .num{
    font-size:44px;
    font-weight:800;
    line-height:1;
    color:var(--blue);
  }
  .martinato-stat .lbl{
    font-size:14px;
    font-weight:600;
    color:var(--ink-soft);
    max-width:16ch;
    line-height:1.3;
  }
  .martinato-photo{
    position:sticky;
    top:100px;
    border-radius:var(--radius-lg);
    overflow:hidden;
    border:1px solid var(--line);
  }
  .martinato-photo img{ width:100%; height:100%; object-fit:cover; display:block; }

  /* ===== Footer ===== */
  footer{
    padding:48px 0 40px;
  }
  .footer-inner{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    flex-wrap:wrap;
    border-top:1px solid var(--line);
    padding-top:32px;
  }
  .footer-brand{ display:flex; align-items:center; gap:12px; }
  .footer-brand img{ height:32px; }
  .footer-brand span{ font-size:13px; font-weight:500; color:var(--ink-soft); }
  footer .fine{ font-size:12.5px; color:var(--ink-soft); }

  /* ===== reveal on scroll ===== */
  .reveal{
    opacity:0;
    transform:translateY(18px);
    transition:opacity .7s ease, transform .7s ease;
  }
  .reveal.in{ opacity:1; transform:translateY(0); }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    .reveal{ opacity:1; transform:none; transition:none; }
  }

  /* ===== Responsive ===== */
  @media (max-width:980px){
    .wrap{ padding:0 22px; }
    .hero{ padding:52px 0 44px; }
    .hero-grid{ grid-template-columns:1fr; gap:44px; }
    .hero-visual{ order:-1; }
    .duo{ max-width:300px; margin:0 auto; }
