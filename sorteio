<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2º Congresso Brasileiro de Óptica | RegenerAÇÃO Óptica</title>
<meta name="description" content="2º Congresso Brasileiro de Óptica — 07 de novembro de 2026, Bento Gonçalves/RS. Cadastre-se e concorra a 10 ingressos regulares e 2 ingressos VIP.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#EF7A1A;
    --orange-deep:#C96410;
    --orange-light:#FF9F4D;
    --blue:#204395;
    --blue-deep:#152C63;
    --blue-bright:#3158B8;
    --blue-sky:#6A8AD9;
    --ink:#101827;
    --paper:#FFFFFF;
    --paper-2:#F1F2F4;
    --text-dark:#232323;
    --text-muted:#5B5F6B;
    --line-dark:rgba(26,26,26,0.1);
    --line-light:rgba(255,255,255,0.22);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    background:var(--paper);
    color:var(--text-dark);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  h1,h2,h3{font-family:'Poppins',sans-serif;font-weight:800;letter-spacing:-0.01em;}
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 28px;}
  .eyebrow{
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    font-weight:700;
    display:inline-flex;
    align-items:center;
    gap:9px;
  }
  .eyebrow::before{
    content:"";
    width:8px;height:8px;border-radius:50%;
    background:var(--orange);
    display:inline-block;
    box-shadow:0 0 0 4px rgba(239,122,26,0.18);
  }
  .eyebrow.on-dark{color:var(--orange-light);}
  .eyebrow.on-light{color:var(--orange-deep);}

  /* ---------- HERO ---------- */
  header.hero{
    background:
      radial-gradient(ellipse 1000px 600px at 90% -15%, rgba(239,122,26,0.35), transparent 55%),
      linear-gradient(160deg, var(--blue-deep) 0%, var(--blue) 100%);
    color:#fff;
    padding:40px 0 56px;
    position:relative;
    overflow:hidden;
  }
  .hero-top{
    display:flex;
    justify-content:flex-start;
    align-items:center;
    padding-bottom:40px;
  }
  .logo-img{height:72px;width:auto;}
  .hero-body{
    max-width:760px;
  }
  .hero-title{
    font-size:clamp(32px,4.4vw,54px);
    line-height:1.08;
    color:#fff;
  }
  .hero-title em{
    font-style:normal;
    color:var(--orange-light);
  }
  .hero-sub{
    margin-top:18px;
    max-width:560px;
    font-size:16.5px;
    color:rgba(255,255,255,0.82);
  }
  .hero-cta{
    margin-top:32px;
    display:flex;
    gap:14px;
    flex-wrap:wrap;
  }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:15px 28px;
    border-radius:40px;
    font-weight:700;
    font-size:14.5px;
    letter-spacing:0.01em;
    cursor:pointer;
    border:1px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .btn-primary{
    background:var(--orange);
    color:#fff;
    box-shadow:0 10px 24px -8px rgba(239,122,26,0.55);
  }
  .btn-primary:hover{transform:translateY(-2px);background:var(--orange-deep);}
  .btn-ghost{border-color:var(--line-light);color:#fff;}
  .btn-ghost:hover{background:rgba(255,255,255,0.1);}

  .fact-strip{
    margin-top:40px;
    display:flex;
    gap:14px;
    background:rgba(255,255,255,0.06);
    border:1px solid var(--line-light);
    border-radius:16px;
    padding:8px;
  }
  .fact{
    flex:1;
    padding:16px 20px;
    border-radius:12px;
    background:rgba(255,255,255,0.08);
    border-left:3px solid var(--orange);
  }
  .fact .label{
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--orange-light);
    font-weight:700;
  }
  .fact .value{
    font-family:'Poppins',sans-serif;
    font-weight:700;
    font-size:17px;
    margin-top:6px;
    color:#fff;
  }

  /* ---------- SECTION SHARED ---------- */
  section{padding:74px 0;}
  .section-head{max-width:680px;margin-bottom:34px;}
  .section-head h2{
    font-size:clamp(26px,3.2vw,38px);
    margin-top:12px;
    color:var(--text-dark);
  }
  .section-head h2 .ink{color:var(--text-dark);}
  .section-head h2 .accent-orange{color:var(--orange);}
  .section-head h2 .accent-blue{color:var(--blue);}

  /* Proposta */
  .proposta{background:var(--paper);}
  .proposta p{
    font-size:17px;
    color:var(--text-muted);
    max-width:680px;
  }
  .proposta p + p{margin-top:14px;}

  /* Para quem é */
  .para-quem{background:var(--paper-2);}
  .cards{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-top:28px;
  }
  .card{
    background:#fff;
    border-top:4px solid var(--orange);
    padding:24px 20px;
    border-radius:10px;
    box-shadow:0 6px 20px -12px rgba(16,24,39,0.25);
  }
  .card:nth-child(2){border-top-color:var(--blue-bright);}
  .card:nth-child(3){border-top-color:var(--orange);}
  .card:nth-child(4){border-top-color:var(--blue-bright);}
  .card .ico{font-size:24px;}
  .card h3{
    font-size:16px;
    margin-top:12px;
    font-family:'Poppins',sans-serif;
    font-weight:700;
  }
  .card p{
    font-size:14px;
    color:var(--text-muted);
    margin-top:8px;
    line-height:1.5;
  }

  /* Você vai sair com */
  .saida{background:var(--paper);}
  .saida-list{
    list-style:none;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px 32px;
    max-width:820px;
  }
  .saida-list li{
    display:flex;
    align-items:flex-start;
    gap:12px;
    font-size:15.5px;
    color:var(--text-dark);
    line-height:1.5;
  }
  .saida-list .check{
    flex-shrink:0;
    width:24px;height:24px;
    border-radius:50%;
    background:var(--orange);
    color:#fff;
    font-size:13px;
    font-weight:700;
    display:flex;align-items:center;justify-content:center;
    margin-top:1px;
  }

  /* Sorteio + form */
  .sorteio{
    background:
      radial-gradient(ellipse 900px 500px at 95% -10%, rgba(255,179,92,0.4), transparent 55%),
      radial-gradient(ellipse 700px 600px at 0% 100%, rgba(255,255,255,0.18), transparent 55%),
      linear-gradient(160deg, var(--blue) 0%, var(--blue-bright) 100%);
    color:#fff;
  }
  .sorteio-grid{
    display:grid;
    grid-template-columns:0.95fr 1.05fr;
    gap:52px;
  }
  .sorteio-copy h2{color:#fff;font-size:clamp(28px,3.4vw,38px);margin-top:14px;}
  .sorteio-copy p{color:rgba(255,255,255,0.82);font-size:16px;margin-top:14px;max-width:440px;}
  .prize-row{
    display:flex;
    gap:16px;
    margin-top:30px;
    flex-wrap:wrap;
  }
  .prize{
    position:relative;
    background:linear-gradient(160deg, rgba(255,255,255,0.16), rgba(255,255,255,0.04));
    border:1px solid rgba(255,255,255,0.3);
    padding:22px 26px;
    border-radius:16px;
    min-width:170px;
    overflow:hidden;
  }
  .prize::after{
    content:"";
    position:absolute;
    top:-30%;right:-20%;
    width:90px;height:90px;
    border-radius:50%;
  }
  .prize.regular::after{background:radial-gradient(circle, rgba(239,122,26,0.5), transparent 70%);}
  .prize.vip::after{background:radial-gradient(circle, rgba(32,67,149,0.55), transparent 70%);}
  .prize .n{
    font-family:'Poppins',sans-serif;
    font-weight:900;
    font-size:44px;
    line-height:1;
    color:var(--orange-light);
  }
  .prize.vip .n{color:var(--orange-light);}
  .prize .l{
    font-size:13px;
    color:rgba(255,255,255,0.9);
    text-transform:uppercase;
    letter-spacing:0.06em;
    font-weight:700;
    margin-top:4px;
  }
  .prize .tag{
    display:inline-block;
    margin-top:10px;
    font-size:11px;
    font-weight:700;
    padding:3px 10px;
    border-radius:20px;
    background:rgba(255,255,255,0.15);
  }

  form.card-form{
    background:#fff;
    color:var(--text-dark);
    border-radius:18px;
    padding:34px;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.35);
  }
  form.card-form h3{
    font-family:'Poppins',sans-serif;
    font-size:19px;
    font-weight:800;
    margin-bottom:4px;
    color:var(--blue-deep);
  }
  form.card-form .form-sub{
    font-size:13.5px;
    color:var(--text-muted);
    margin-bottom:22px;
    font-weight:600;
  }
  .field{margin-bottom:16px;}
  .field label{
    display:block;
    font-size:12.5px;
    font-weight:700;
    margin-bottom:6px;
    color:var(--text-dark);
  }
  .field input,.field select{
    width:100%;
    padding:12px 14px;
    border:1.5px solid #EAE3D8;
    border-radius:8px;
    font-family:'Inter',sans-serif;
    font-size:14.5px;
    background:#FFFCF8;
    color:var(--text-dark);
  }
  .field input:focus,.field select:focus{
    outline:none;
    border-color:var(--orange);
    box-shadow:0 0 0 3px rgba(239,122,26,0.18);
  }
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .form-submit{
    width:100%;
    margin-top:6px;
    background:var(--orange);
    color:#fff;
    border:none;
    padding:15px 18px;
    border-radius:10px;
    font-weight:800;
    font-size:15px;
    cursor:pointer;
    box-shadow:0 12px 24px -10px rgba(239,122,26,0.55);
    transition:transform .15s ease, background .15s ease;
  }
  .form-submit:hover{transform:translateY(-2px);background:var(--orange-deep);}
  .form-fine{
    font-size:11.5px;
    color:var(--text-muted);
    margin-top:12px;
    line-height:1.5;
  }
  .form-success{
    display:none;
    text-align:center;
    padding:20px 0;
  }
  .form-success.show{display:block;}
  .form-success .check{
    width:48px;height:48px;border-radius:50%;
    background:var(--blue);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 14px;font-size:22px;
  }
  .form-success h3{font-family:'Poppins',sans-serif;font-size:21px;color:var(--blue-deep);}
  .form-success p{font-size:14px;color:var(--text-muted);margin-top:6px;}

  /* Conheça o movimento */
  .movimento{
    background:var(--orange);
    color:#fff;
  }
  .movimento-inner{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:36px;
    flex-wrap:wrap;
  }
  .movimento .eyebrow{color:#fff;}
  .movimento .eyebrow::before{background:#fff;box-shadow:0 0 0 4px rgba(255,255,255,0.25);}
  .movimento h2{color:#fff;font-size:clamp(24px,2.8vw,32px);margin-top:12px;max-width:520px;}
  .movimento p{color:rgba(255,255,255,0.9);font-size:15.5px;margin-top:12px;max-width:480px;}
  .movimento-links{display:flex;gap:14px;flex-wrap:wrap;}
  .movimento .btn-primary{background:#fff;color:var(--orange-deep);box-shadow:0 10px 24px -8px rgba(0,0,0,0.25);}
  .movimento .btn-primary:hover{background:#fff;color:var(--orange-deep);transform:translateY(-2px);}
  .btn-outline{border:1.5px solid rgba(255,255,255,0.7);color:#fff;}
  .btn-outline:hover{background:rgba(255,255,255,0.15);}

  /* Footer */
  footer{
    background:var(--blue-deep);
    color:rgba(255,255,255,0.65);
    padding:44px 0 28px;
  }
  .footer-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:18px;
    padding-bottom:26px;
    border-bottom:1px solid rgba(255,255,255,0.14);
  }
  .footer-logo{height:28px;}
  footer .foot-links{display:flex;gap:22px;font-size:13.5px;}
  footer .foot-links a:hover{color:#fff;}
  .foot-bottom{
    padding-top:22px;
    font-size:12.5px;
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:10px;
    color:rgba(255,255,255,0.45);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:860px){
    .cards{grid-template-columns:repeat(2,1fr);}
    .sorteio-grid{grid-template-columns:1fr;gap:36px;}
    .fact-strip{flex-wrap:wrap;}
    .fact{flex:1 1 calc(50% - 7px);}
  }
  @media (max-width:560px){
    .wrap{padding:0 20px;}
    .hero-top{padding-bottom:28px;}
    section{padding:52px 0;}
    .cards{grid-template-columns:1fr;}
    .saida-list{grid-template-columns:1fr;}
    .field-row{grid-template-columns:1fr;}
    form.card-form{padding:24px 20px;}
    .fact{flex:1 1 100%;}
    .prize{min-width:140px;padding:18px 20px;}
    .prize .n{font-size:36px;}
    .movimento-inner{flex-direction:column;align-items:flex-start;}
    .movimento-links{width:100%;}
    .movimento-links .btn{flex:1;justify-content:center;}
  }
</style>
</head>
<body>

<header class="hero">
  <div class="wrap">
    <div class="hero-top">
      <img class="logo-img" src="data:image/png;base64," alt="RegenerAÇÃO Óptica">
    </div>

    <div class="hero-body">
      <h1 class="hero-title">Pare de competir por <em>preço</em>.<br>Comece a construir <em>valor</em>.</h1>
      <p class="hero-sub">Este evento é para quem enxerga além. Uma proposta inédita no Brasil: reunir lojistas independentes que querem vender mais, prosperar com propósito e transformar a forma como se relacionam com suas equipes e clientes.</p>

      <div class="fact-strip">
        <div class="fact">
          <div class="label">Data</div>
          <div class="value">07/11/2026</div>
        </div>
        <div class="fact">
          <div class="label">Horário</div>
          <div class="value">Das 8h às 18h</div>
        </div>
        <div class="fact">
          <div class="label">Local</div>
          <div class="value">Dall'Onder Grande Hotel</div>
        </div>
        <div class="fact">
          <div class="label">Cidade</div>
          <div class="value">Bento Gonçalves, RS</div>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#sorteio" class="btn btn-primary">Cadastre-se e concorra a ingressos</a>
      </div>
    </div>
  </div>
</header>

<section class="proposta">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow on-light">A proposta</span>
      <h2><span class="accent-blue">Por que esse congresso</span> <span class="accent-orange">existe</span></h2>
    </div>
    <p>O Congresso Brasileiro de Óptica existe para educar, conectar e fortalecer o setor óptico brasileiro, preparando profissionais e empresas para o presente e, principalmente, para o futuro.</p>
    <p>Nasceu para dar voz ao óptico, valorizar quem está na linha de frente e criar um espaço onde conhecimento é compartilhado, experiências se encontram e o mercado evolui junto.</p>
  </div>
</section>

<section class="para-quem">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow on-light">Para quem é</span>
      <h2><span class="accent-blue">Esse evento não é para todos. É para você.</span></h2>
    </div>
    <div class="cards">
      <div class="card">
        <div class="ico">🏪</div>
        <h3>Donos de ótica</h3>
        <p>Que querem parar de competir por preço e construir uma marca com autoridade e resultado real.</p>
      </div>
      <div class="card">
        <div class="ico">👥</div>
        <h3>Equipes comerciais</h3>
        <p>Vendedores e atendentes que entendem que um atendimento extraordinário é a maior vantagem competitiva.</p>
      </div>
      <div class="card">
        <div class="ico">🎯</div>
        <h3>Profissionais do setor</h3>
        <p>Quem já entendeu que encantar o cliente não é opcional e quer fazer parte de um movimento real.</p>
      </div>
      <div class="card">
        <div class="ico">📈</div>
        <h3>Gestores e líderes</h3>
        <p>Que querem construir equipes engajadas e uma cultura de alta performance na ótica.</p>
      </div>
    </div>
  </div>
</section>

<section class="saida">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow on-light">O que você leva</span>
      <h2><span class="accent-blue">Você vai sair com</span></h2>
    </div>
    <ul class="saida-list">
      <li><span class="check">✓</span>Estratégias de vendas, marketing, finanças e gestão prontas para aplicar</li>
      <li><span class="check">✓</span>Inspiração para reposicionar sua ótica com autoridade no mercado</li>
      <li><span class="check">✓</span>Ferramentas de liderança e mentalidade para engajar sua equipe</li>
      <li><span class="check">✓</span>Networking real com lojistas que compartilham as mesmas vivências</li>
      <li><span class="check">✓</span>Parte de um movimento coletivo de regeneração do varejo óptico</li>
      <li><span class="check">✓</span>Uma nova forma de enxergar o potencial da sua ótica</li>
    </ul>
  </div>
</section>

<section class="sorteio" id="sorteio">
  <div class="wrap sorteio-grid">
    <div class="sorteio-copy">
      <span class="eyebrow on-dark">Sorteio exclusivo</span>
      <h2>Preencha seus dados para participar do sorteio oficial do 2º Congresso Brasileiro de Óptica</h2>
      <div class="prize-row">
        <div class="prize regular">
          <div class="n">10</div>
          <div class="l">Ingressos regulares</div>
          <span class="tag">🎟️ Padrão</span>
        </div>
        <div class="prize vip">
          <div class="n">2</div>
          <div class="l">Ingressos VIP</div>
          <span class="tag">⭐ Experiência exclusiva</span>
        </div>
      </div>
    </div>

    <div>
      <form class="card-form" id="cadastroForm"
            method="POST"
            action="https://2c963706.sibforms.com/serve/MUIFADetvVsemLLMWgaeaFPpZmUJHuBhY-Vz2p-OSyEwkIeNqAZ0rjpspGg3Q8Re_rMXi_AlrGtMUJg7kZcHX6ffNjnZHlXK7n0OFt2aTRCQ2BjBeKYCm0pPcuQS1Wdkjn0cinGVtkcgigEJ5Ak1PUdx4Bw8-nQKPzqJotgGzs9wCfleecv0n-MvJFhqhGd7EjEg7UkS2_MRqLOEYA=="
            target="brevo_hidden_frame">
        <div id="formFields">
          <h3>Faça seu cadastro</h3>
          <p class="form-sub">Cadastro gratuito.</p>

          <div class="field">
            <label for="NOME">Nome completo</label>
            <input type="text" id="NOME" name="NOME" required autocomplete="name" maxlength="200">
          </div>

          <div class="field-row">
            <div class="field">
              <label for="EMAIL">E-mail</label>
              <input type="email" id="EMAIL" name="EMAIL" required autocomplete="email">
            </div>
            <div class="field">
              <label for="SMS">WhatsApp</label>
              <input type="tel" id="SMS" name="SMS" placeholder="11999999999 (DDD + número)" required autocomplete="tel" pattern="[0-9]{10,11}" title="Informe DDD + número, apenas números">
              <input type="hidden" name="SMS__COUNTRY_CODE" value="+55">
            </div>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="OPTICA">Nome da ótica / empresa</label>
              <input type="text" id="OPTICA" name="OPTICA" maxlength="200">
            </div>
            <div class="field">
              <label for="CIDADE">Cidade / Estado</label>
              <input type="text" id="CIDADE" name="CIDADE" required maxlength="200">
            </div>
          </div>

          <button type="submit" class="form-submit">Confirmar cadastro</button>
          <p class="form-fine">Ao se cadastrar, você concorda em receber comunicações sobre o 2º Congresso Brasileiro de Óptica. Seus dados não serão compartilhados com terceiros.</p>

          <input type="text" name="email_address_check" value="" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" tabindex="-1" autocomplete="off">
          <input type="hidden" name="locale" value="pt">
          <input type="hidden" name="html_type" value="simple">
        </div>

        <div class="form-success" id="formSuccess">
